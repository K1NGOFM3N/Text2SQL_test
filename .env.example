# Required
ANTHROPIC_API_KEY=sk-ant-...

# Optional
CLAUDE_MODEL=claude-sonnet-5-5
MAX_ROWS=500
QUERY_TIMEOUT_SECONDS=30
SESSION_TTL_MINUTES=30
MAX_SCHEMA_TABLES=150

# Comma-separated list of database hosts users may connect to.
# Leave empty to allow any host (only do that on a trusted network).
ALLOWED_DB_HOSTS=

# Let users open SQLite files on the server's own disk. Off by default.
ALLOW_SQLITE=false
